---
import { SITE } from "../site.config";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  type?: "website" | "article";
  pubDate?: Date;
};

const {
  title = SITE.title,
  description = SITE.description,
  canonicalPath = Astro.url.pathname,
  type = "website",
  pubDate
} = Astro.props;

const siteUrl = Astro.site ?? new URL(SITE.url);
const pageTitle = title === SITE.title ? SITE.title : `${title} | ${SITE.title}`;
const canonicalUrl = new URL(canonicalPath, siteUrl);
const rssUrl = new URL("/rss.xml", siteUrl);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={rssUrl.href}
    />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-brand" href="/" aria-label="ukyo.dev home">ukyo.dev</a>
        <nav class="site-nav" aria-label="Primary">
          <a href={SITE.github} rel="me">GitHub</a>
          <a href={SITE.twitter} rel="me">Twitter</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} {SITE.author}</p>
      </footer>
    </div>
  </body>
</html>
