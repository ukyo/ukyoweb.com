---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../site.config";
import { formatDate, getPostExcerpt, getPostUrl, sortPosts } from "../lib/posts";

const posts = sortPosts(
  await getCollection("blog", ({ data }) => data.draft !== true)
);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="home-intro" aria-labelledby="page-title">
    <p class="eyebrow">Technical notes</p>
    <h1 id="page-title">ukyo.dev</h1>
    <p>
      WebAssembly、フロントエンド、ビルドツールまわりのメモを置いています。
    </p>
  </section>

  <section class="post-index" aria-label="記事一覧">
    <div class="section-heading">
      <h2>Articles</h2>
      <span>{posts.length} posts</span>
    </div>

    <ol class="post-list">
      {
        posts.map((post) => (
          <li>
            <a class="post-list-link" href={getPostUrl(post)}>
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              <span>
                <strong>{post.data.title}</strong>
                <em>{post.data.description ?? getPostExcerpt(post.body)}</em>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
